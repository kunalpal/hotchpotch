# Konsole Environment Variables Example

# Next.js Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=better-auth-secret...
BETTER_AUTH_URL=$NEXT_PUBLIC_SITE_URL
GOOGLE_CLIENT_ID=google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=google-client-secret

# Database
# Production: neon postgres url
# Local Dev: postgresql://postgres:password@localhost:5432/hotchpotch
NEON_DATABASE_URL=postgresql://postgres:password@localhost:5432/hotchpotch

# AI Provider: 'mock' | 'gateway' | 'bedrock' (default: gateway)
NEXT_PUBLIC_AI_PROVIDER=mock

# Default model ID (optional — falls back to provider default if unset)
# Gateway example:  deepseek/deepseek-v4-flash
# Bedrock example:  anthropic.claude-3-5-sonnet-20241022-v2:0
# AI_MODEL=

# Vercel AI Gateway (required when NEXT_PUBLIC_AI_PROVIDER=gateway)
AI_GATEWAY_API_KEY=ai-gateway-api-key...

# AWS Bedrock (required when NEXT_PUBLIC_AI_PROVIDER=bedrock)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1