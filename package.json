{
  "name": "hotchpotch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "dotenv -e .env.local -o -- next dev | pino-pretty",
    "build": "next build && npm run lint && npm run format",
    "start": "next start",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --write . --cache --list-different",
    "format:check": "prettier --check . --cache --list-different",
    "test": "vitest run",
    "localstack:up": "podman compose up -d",
    "localstack:down": "podman compose down",
    "test:watch": "vitest",
    "e2e": "npx playwright test",
    "e2e:ui": "npx playwright test --ui",
    "drizzle:push:local": "dotenv -e .env.local -o -- drizzle-kit push",
    "db:seed": "dotenv -e .env.local -o -- npx tsx src/db/scripts/cli.ts"
  },
  "dependencies": {
